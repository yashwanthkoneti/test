
#!/usr/bin/env python3
import re
import sys
import pdfplumber
import json

START_RE = re.compile(r"TABLE\s*4", re.I)
END_RE = re.compile(r"^\s*NOTES\b", re.I)
SERIAL_RE = re.compile(r"^\s*(\d+)\.\s*$|^\s*(\d+)\.\s+(.*)")
NUM_RE = re.compile(r"[+-]?\d+\.\d+")

def iter_lines(pdf_path):
    started = False
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            text = page.extract_text(layout=True) or ""
            for raw in text.splitlines():
                line = raw.rstrip()
                if not started:
                    if START_RE.search(line):
                        started = True
                    continue
                if END_RE.match(line):
                    return
                yield line

def parse(pdf_path):
    records = []
    failed = []
    lines = iter_lines(pdf_path)

    current = None
    collecting_country = False

    for line in lines:
        m = SERIAL_RE.match(line)
        if current is None:
            if m:
                serial = m.group(1) or m.group(2)
                rest = (m.group(3) or "").strip()
                current = {
                    "serial": serial,
                    "country": rest,
                    "numbers": [],
                    "raw": [line]
                }
                collecting_country = True
            continue

        current["raw"].append(line)

        if collecting_country:
            nums = NUM_RE.findall(line)
            if nums:
                if current["country"]:
                    current["country"] = " ".join(current["country"].split())
                current["numbers"].extend(nums)
                collecting_country = False
            else:
                current["country"] = (current["country"] + " " + line.strip()).strip()
            continue

        nums = NUM_RE.findall(line)
        if nums:
            current["numbers"].extend(nums)

        if len(current["numbers"]) >= 26:
            records.append(current)
            extra = current["numbers"][26:]
            current = None
            collecting_country = False
            if extra:
                failed.append({
                    "reason":"extra numeric tokens after record completion",
                    "extra":extra
                })

    if current:
        failed.append(current)

    with open("raw_records.json","w",encoding="utf-8") as f:
        json.dump(records,f,indent=2,ensure_ascii=False)

    with open("failed_rows.txt","w",encoding="utf-8") as f:
        for r in failed:
            f.write(json.dumps(r,ensure_ascii=False))
            f.write("\n\n")

    print(f"Records: {len(records)}")
    print(f"Failed: {len(failed)}")
    print("Output: raw_records.json, failed_rows.txt")

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: python parse_table4_stream.py input.pdf")
        sys.exit(1)
    parse(sys.argv[1])
