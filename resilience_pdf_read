import pdfplumber
import pandas as pd
import re

START_MARKER = "TABLE 4"
END_MARKER = "NOTES"
EXPECTED_VALUES = 26

NUMBER_RE = re.compile(r"-?\d+\.\d+")
ROW_RE = re.compile(r"^\d+\.")

def extract_section(pdf_path):
    reading = False
    lines = []

    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            text = page.extract_text(layout=True) or ""

            if START_MARKER in text:
                reading = True

            if not reading:
                continue

            for line in text.split("\n"):
                if END_MARKER in line:
                    reading = False
                    break

                line = re.sub(r"\s+", " ", line).strip()

                if line:
                    lines.append(line)

            if not reading:
                break

    return lines


def merge_lines(lines):
    merged = []

    for line in lines:

        if ROW_RE.match(line):
            merged.append(line)
        else:
            if merged:
                merged[-1] += " " + line

    return merged


def parse(lines):

    records = []

    for line in lines:

        if not ROW_RE.match(line):
            continue

        nums = NUMBER_RE.findall(line)

        if len(nums) < EXPECTED_VALUES:
            continue

        nums = nums[:EXPECTED_VALUES]

        m = NUMBER_RE.search(line)

        left = line[:m.start()].strip()

        rank = re.findall(r"^\d+", left)[0]

        country = re.sub(r"^\d+\.\s*", "", left)
        country = re.sub(r"\s+", " ", country).strip()

        rec = {
            "Rank": int(rank),
            "Country": country
        }

        for i, v in enumerate(nums, 1):
            rec[f"Value_{i}"] = float(v)

        records.append(rec)

    return pd.DataFrame(records)


def main(pdf_path):

    lines = extract_section(pdf_path)

    lines = merge_lines(lines)

    df = parse(lines)

    print(df.head())
    print()
    print("Rows:", len(df))

    df.to_csv("table4_output.csv", index=False)

    failed = []

    for line in lines:

        if ROW_RE.match(line):

            nums = NUMBER_RE.findall(line)

            if len(nums) < EXPECTED_VALUES:
                failed.append(line)

    print("Failed rows:", len(failed))

    if failed:
        with open("failed_rows.txt", "w", encoding="utf-8") as f:
            for r in failed:
                f.write(r + "\\n")

        print("Saved failed_rows.txt")


if __name__ == "__main__":

    import sys

    if len(sys.argv) != 2:
        print("Usage: python parser.py <pdf>")
    else:
        main(sys.argv[1])
